# Frontend Vite : port du serveur local et URL de l'API backend.
VITE_PORT=8080

# Local : laisser vide pour passer par le proxy Vite vers le backend local.
# Déploiement séparé : URL publique du backend, sans /api à la fin.
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Domaine public du bucket des médias, sans slash final. Laisser vide en local.
# VITE_PUBLIC_CONTENT_URL=https://media.example.com
VITE_PUBLIC_CONTENT_URL=
